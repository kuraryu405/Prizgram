# SQLite database file. Relative paths are resolved from the repository root.
# A standalone deployment must use an absolute path (for example,
# DATABASE_URL=file:/var/lib/prizgram/prizgram.sqlite).
DATABASE_URL=file:./data/prizgram.sqlite

# Canonical browser origin used for every state-changing API request.
# Required in production: POST/PUT/PATCH/DELETE requests are rejected while
# unset. Browser-external mutation clients without Origin are not supported.
# Production also serves a __Host- session cookie, which requires HTTPS.
APP_ORIGIN=http://localhost:3000

# OpenAI-compatible API. Keep the API key server-side and out of source control.
# Job discovery uses this for persona-based query generation and best-effort
# company-name extraction when a provider omits the employer name.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-a-local-secret
OPENAI_MODEL=replace-with-a-structured-output-capable-model
OPENAI_TIMEOUT_MS=30000

# LLM operation rate limiting (per authenticated user and application process).
# Every LLM-backed route shares this budget. Multiple application instances do
# not share counters and require a shared rate-limit store when introduced.
# LLM_RATE_LIMIT_WINDOW_MS=60000
# LLM_RATE_LIMIT_MAX_REQUESTS=10
# LLM_RATE_LIMIT_MAX_TRACKED_USERS=10000

# Careerjet partner job search API (https://www.careerjet.com/partners/api).
# Careerjet is optional in multi-provider discovery. When configured, the key
# is server-only; requests also forward the caller's IP and user agent, which
# the provider contract requires.
CAREERJET_API_KEY=
# CAREERJET_LOCALE_CODE=ja_JP
# CAREERJET_TIMEOUT_MS=15000
# Registered partner site origin sent as the Referer header. Defaults to
# APP_ORIGIN when unset. Must match the origin registered with Careerjet
# together with this server's outbound IP.
# CAREERJET_SITE_URL=https://prizgram.kuraryu.jp

# Himalayas and Jobicy are public providers and require no API keys. These
# settings are optional overrides; normally leave them unset in production.
# HIMALAYAS_BASE_URL=https://himalayas.app/jobs/api
# HIMALAYAS_SEARCH_BASE_URL=https://himalayas.app/jobs/api/search
# HIMALAYAS_TIMEOUT_MS=10000
# JOBICY_BASE_URL=https://jobicy.com/api/v2/remote-jobs
# JOBICY_TIMEOUT_MS=10000

# Authentication rate limiting (per application instance).
# AUTH_RATE_LIMIT_* bounds authentication attempts per client source
# (Cloudflare Tunnel's CF-Connecting-IP; direct access to the app port must be
# blocked). AUTH_RATE_LIMIT_MAX_TRACKED_SOURCES is
# a memory bound: when that many live source windows are tracked, unseen
# sources are rejected until windows expire. AUTH_SCRYPT_* bounds concurrent
# and queued scrypt password derivations globally; saturation answers 429.
# AUTH_RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_MAX_REQUESTS=10
# AUTH_RATE_LIMIT_MAX_TRACKED_SOURCES=10000
# AUTH_SCRYPT_MAX_CONCURRENT=4
# AUTH_SCRYPT_MAX_QUEUED=64
# AUTH_SCRYPT_QUEUE_TIMEOUT_MS=5000
